{
  "name": "bitempura-viz-client",
  "version": "0.0.1",
  "homepage": "https://elh.github.io/bitempura-viz",
  "description": "Bitemporal database visualization",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elh/bitempura-viz.git"
  },
  "keywords": [],
  "author": "elh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/elh/bitempura-viz/issues"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "lodash.clonedeep": "^4.5.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^5.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predeploy": "REACT_APP_USE_FIXTURES=true npm run build",
    "deploy": "gh-pages -d build",
    "start": "node scripts/start.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:tooling": "node --test scripts/*.test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "gh-pages": "^5.0.0"
  },
  "overrides": {
    "nth-check": "2.1.1",
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0",
    "underscore": "^1.13.8",
    "@tootallnate/once": "^2.0.1",
    "uuid": "^11.1.1",
    "serialize-javascript": "^7.0.5",
    "react-scripts": {
      "@svgr/webpack": "^6.5.1",
      "resolve-url-loader": "^5.0.0",
      "webpack-dev-server": "5.2.6"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "jest": {
    "transformIgnorePatterns": ["node_modules/(?!(react-markdown|unified|bail|is-plain-obj|trough|vfile|vfile-message|unist-util-.*|remark-.*|mdast-util-.*|micromark.*|decode-named-character-reference|character-entities.*|property-information|hast-util-.*|space-separated-tokens|comma-separated-tokens|trim-lines|ccount|escape-string-regexp)/)"]
  }
}
